#version 430 core

/**
 * The photon grid, pass 1 of 3: how many stored photon vertices fall in each cell of the
 * hash grid (cells of the gather radius, hashed into cellMask + 1 entries). The gather in
 * pathTrace (lights.glsl, cellKey) uses the same hash.
 */

layout(local_size_x = 256) in;

layout(std430, binding = 8) readonly buffer PhotonVertices { vec4 photonData[]; };   // 4 vec4 per photon: pos+flag, flux, normal, wIn
layout(std430, binding = 10) buffer CellCount { uint cellCount[]; };

uniform int photonCount;
uniform float cellSize;
uniform int cellMask;

uint cellKey(vec3 p) {
    ivec3 c = ivec3(floor(p / cellSize));
    uint h = uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^ uint(c.z) * 83492791u;
    return h & uint(cellMask);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(photonCount)) return;
    vec4 pf = photonData[4u * i];
    if (pf.w < 0.5) return;
    atomicAdd(cellCount[cellKey(pf.xyz)], 1u);
}
